# Copy to .env and fill in your own keys. Never commit .env.
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEYS=gsk_key_1,gsk_key_2

# Razorpay Test Mode (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Set false to hide the demo controls panel
DEMO_MODE=True

DATABASE_URL=sqlite:///./razorflow.db
